<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_retail_expiry_report_wizard_form" model="ir.ui.view">
        <field name="name">retail.expiry.report.wizard.form</field>
        <field name="model">retail.expiry.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Отбор партий по сроку годности">
                <group>
                    <field name="days_ahead"/>
                </group>
                <footer>
                    <button name="action_view_expiring_lots" type="object"
                            string="Показать партии" class="btn-primary"/>
                    <button string="Отмена" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
