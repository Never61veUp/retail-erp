<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_retail_stock_alert" model="ir.cron">
        <field name="name">Retail: check stock deficit alerts</field>
        <field name="model_id" ref="model_retail_stock_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_stock_alerts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="datetime.now()"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
