<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_retail_stock_alert_list" model="ir.ui.view">
        <field name="name">retail.stock.alert.list</field>
        <field name="model">retail.stock.alert</field>
        <field name="arch" type="xml">
            <list
                string="Stock Alerts"
                decoration-danger="state == 'new'"
                decoration-warning="state == 'ordered'"
                decoration-success="state == 'done'"
            >
                <field name="date"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="qty_available"/>
                <field name="qty_forecast"/>
                <field name="product_min_qty" string="Min"/>
                <field name="product_max_qty" string="Max"/>
                <field name="recommended_qty"/>
                <field name="state" widget="badge"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="purchase_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_retail_stock_alert_form" model="ir.ui.view">
        <field name="name">retail.stock.alert.form</field>
        <field name="model">retail.stock.alert</field>
        <field name="arch" type="xml">
            <form string="Stock Alert">
                <header>
                    <button
                        name="action_create_purchase_order"
                        type="object"
                        string="Create Purchase Order"
                        class="btn-primary"
                        invisible="state != 'new'"
                    />
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="new,ordered,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="qty_available" readonly="1"/>
                            <field name="qty_forecast" readonly="1"/>
                            <field name="product_min_qty" readonly="1"/>
                            <field name="product_max_qty" readonly="1"/>
                            <field name="recommended_qty"/>
                        </group>
                    </group>
                    <group>
                        <field name="purchase_order_id" readonly="1"/>
                        <field name="user_id"/>
                        <field name="date" readonly="1"/>
                        <field name="last_check_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_retail_stock_alert_search" model="ir.ui.view">
        <field name="name">retail.stock.alert.search</field>
        <field name="model">retail.stock.alert</field>
        <field name="arch" type="xml">
            <search string="Stock Alerts">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <filter name="new" string="To Order" domain="[('state', '=', 'new')]"/>
                <filter name="ordered" string="Ordered" domain="[('state', '=', 'ordered')]"/>
                <filter name="done" string="Resolved" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="mine" string="My Alerts" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_product" string="Product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" domain="[]" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_location" string="Location" domain="[]" context="{'group_by': 'location_id'}"/>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_retail_stock_alert" model="ir.actions.act_window">
        <field name="name">Stock Alerts</field>
        <field name="res_model">retail.stock.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_retail_stock_alert_search"/>
        <field name="context">{'search_default_new': 1}</field>
    </record>

    <menuitem
        id="menu_retail_stock_alert_purchase"
        name="Stock Alerts"
        parent="purchase.menu_purchase_root"
        action="action_retail_stock_alert"
        sequence="15"
    />

    <menuitem
        id="menu_retail_stock_alert_inventory"
        name="Stock Alerts"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_retail_stock_alert"
        sequence="90"
    />
</odoo>
